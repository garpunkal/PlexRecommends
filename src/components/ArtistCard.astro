---
import type { PlexArtist } from '../types/plex';

interface Props {
	artist: PlexArtist;
	href?: string;
}

const props = Astro.props as Props;
const artist = props.artist;
const href = props.href ?? `/artist/${encodeURIComponent(artist.id)}`;
const summary =
	artist.summary && artist.summary.length > 120
		? `${artist.summary.slice(0, 117).trim()}...`
		: artist.summary;
---

<a
	href={href}
	class="group flex h-full flex-col overflow-hidden rounded-3xl border border-white/10 bg-slate-800/80 shadow-lg shadow-black/10 transition duration-300 hover:-translate-y-1 hover:border-[#e5a00d]/50 hover:shadow-2xl hover:shadow-[#e5a00d]/10"
>
	<div class="aspect-5/4 overflow-hidden bg-slate-700/80">
		{
			artist.thumbUrl ? (
				<img
					src={artist.thumbUrl}
					alt={`${artist.name} artwork`}
					loading="lazy"
					class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
				/>
			) : (
				<div class="flex h-full items-center justify-center bg-linear-to-br from-slate-700 via-slate-800 to-slate-900 text-center text-sm font-medium text-slate-400 animate-pulse">
					No artwork
				</div>
			)
		}
	</div>

	<div class="flex flex-1 flex-col gap-4 p-5">
		<div class="flex items-start justify-between gap-3">
			<div>
				<h3 class="text-md font-semibold text-white transition group-hover:text-[#f4c561]">
					{artist.name}
				</h3>
				<p class="mt-1 text-sm text-slate-400">
					{artist.albumCount} {artist.albumCount === 1 ? 'album' : 'albums'}
				</p>
			</div>

			<!-- <span class="rounded-full border border-[#e5a00d]/20 bg-[#e5a00d]/10 px-2.5 py-1 text-xs font-medium text-[#f4c561]">
				Plex
			</span> -->
		</div>

		<!-- <p class="text-sm leading-6 text-slate-300">
			{summary ?? 'Browse albums and explore recommendation signals from your connected sources.'}
		</p> -->
	</div>
</a>
