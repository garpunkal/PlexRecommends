---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import DiscoverCard from '../components/DiscoverCard.astro';
import { getAllArtists } from '../lib/plex';
import { getDiscoveryRecommendations } from '../lib/recommendations';
import { amazonArtistUrl, amazonAlbumUrl, youtubeMusicArtistUrl, youtubeMusicAlbumUrl } from '../lib/amazon';
import type { ArtistRecommendation, AlbumRecommendation } from '../types/recommendations';

let artistRecommendations: ArtistRecommendation[] = [];
let albumRecommendations: AlbumRecommendation[] = [];
let errorMessage: string | null = null;

try {
	const libraryArtists = await getAllArtists();
	const discovery = await getDiscoveryRecommendations(libraryArtists, 8, 30, 30);
	artistRecommendations = discovery.artists;
	albumRecommendations = discovery.albums;
} catch (error) {
	errorMessage = error instanceof Error ? error.message : 'Unable to load discovery recommendations.';
	Astro.response.status = 500;
}
---

<BaseLayout
	title="Discover | PlexRecommends"
	description="A curated discovery feed of recommended artists and albums from Last.fm, with outbound links to Amazon Music UK."
>
	<!-- Page header -->
	<section class="mb-10 grid gap-6 lg:grid-cols-[minmax(0,1.7fr)_minmax(18rem,1fr)]">
		<div class="rounded-3xl border border-white/10 bg-slate-800/80 p-8 shadow-2xl shadow-black/20">
			<p class="mb-3 inline-flex items-center gap-2 rounded-full border border-[#e5a00d]/30 bg-[#e5a00d]/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-[#f4c561]">
				Discovery feed
			</p>
			<h1 class="text-4xl font-semibold tracking-tight text-white sm:text-5xl">
				Explore beyond your library.
			</h1>
			<p class="mt-4 max-w-3xl text-base leading-7 text-slate-300 sm:text-lg">
					Recommendations seeded from a random sample of <strong class="text-white">your Plex library</strong> — artists you already love, fanned out via Last.fm similarity.
					Every pick links directly to <strong class="text-white">Amazon Music UK</strong> and <strong class="text-white">YouTube Music</strong> so you can
					listen immediately. Library artists are excluded so you only see new discoveries.
			</p>
		</div>

		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
			<div class="rounded-3xl border border-white/10 bg-slate-800/80 p-6">
				<p class="text-sm font-medium uppercase tracking-[0.22em] text-slate-400">Artist picks</p>
				<p class="mt-3 text-4xl font-semibold text-white">{artistRecommendations.length}</p>
				<p class="mt-2 text-sm text-slate-400">Seeded from a random sample of your library.</p>
			</div>
			<div class="rounded-3xl border border-white/10 bg-slate-800/80 p-6">
				<p class="text-sm font-medium uppercase tracking-[0.22em] text-slate-400">Album picks</p>
				<p class="mt-3 text-4xl font-semibold text-white">{albumRecommendations.length}</p>
				<p class="mt-2 text-sm text-slate-400">Derived from top discovery artists via Last.fm tag feeds.</p>
			</div>
		</div>
	</section>

	{
		errorMessage ? (
			<section class="rounded-3xl border border-rose-400/30 bg-rose-400/10 p-8 text-rose-100">
				<h2 class="text-xl font-semibold">Discovery unavailable</h2>
				<p class="mt-3 text-sm leading-6 text-rose-100/90">{errorMessage}</p>
				<p class="mt-3 text-sm text-rose-100/80">
					Make sure <code class="rounded bg-black/20 px-2 py-1">LASTFM_API_KEY</code> is set in your{' '}
					<code class="rounded bg-black/20 px-2 py-1">.env</code> file and reload the page.
				</p>
			</section>
		) : (
			<>
				<!-- Artist picks -->
				{artistRecommendations.length > 0 && (
					<section class="mb-10">
						<div class="mb-5">
							<h2 class="text-2xl font-semibold text-white">Artist picks</h2>
							<p class="mt-1 text-sm text-slate-400">
								Artists you might enjoy — scored by Last.fm similarity and cross-source overlap.
							</p>
						</div>

						<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
							{artistRecommendations.map((artist) => (
								<DiscoverCard
									kind="artist"
									name={artist.name}
									subtitle={
										artist.tags.length > 0
											? artist.tags.slice(0, 2).join(' · ')
											: 'Similar artist'
									}
									imageUrl={artist.imageUrl}
									tags={artist.tags}
									sources={artist.sources}
									score={artist.score}
									amazonUrl={amazonArtistUrl(artist.name)}
									youtubeMusicUrl={youtubeMusicArtistUrl(artist.name)}
									plexHref={
										artist.plexArtistId
											? `/artist/${encodeURIComponent(artist.plexArtistId)}`
											: undefined
									}
								/>
							))}
						</div>
					</section>
				)}

				<!-- Album picks -->
				{albumRecommendations.length > 0 && (
					<section>
						<div class="mb-5">
							<h2 class="text-2xl font-semibold text-white">Album picks</h2>
							<p class="mt-1 text-sm text-slate-400">
								Albums surfaced from Last.fm tag feeds for the top discovered artists.
							</p>
						</div>

						<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4">
							{albumRecommendations.map((album) => (
								<DiscoverCard
									kind="album"
									name={album.title}
									subtitle={album.artistName}
									imageUrl={album.imageUrl}
									tags={album.tags}
									sources={album.sources}
									score={album.score}
									amazonUrl={amazonAlbumUrl(album.artistName, album.title)}
									youtubeMusicUrl={youtubeMusicAlbumUrl(album.artistName, album.title)}
								/>
							))}
						</div>
					</section>
				)}

				<!-- Empty state (both lists empty, no error) -->
				{artistRecommendations.length === 0 && albumRecommendations.length === 0 && (
					<section class="rounded-3xl border border-dashed border-white/10 bg-slate-900/40 p-10 text-center">
						<p class="text-base font-medium text-slate-300">No discovery results yet.</p>
						<p class="mt-2 text-sm text-slate-400">
							The Last.fm chart API may be temporarily unavailable. Try refreshing the page.
						</p>
					</section>
				)}
			</>
		)
	}
</BaseLayout>
